# =============================================================================
#  QAGRedo — .env (host-side settings, generated by setup_offline.sh)
# =============================================================================
#
#  READ THIS FIRST (layman quick start)
#  ------------------------------------
#  You only need to touch TWO things before running the first time:
#
#      STEP 1.  Confirm/adjust the profile in section [1] below.
#      STEP 2.  Tell it where your DATA and MODELS live in sections [2]-[4].
#
#  Then run:        bash run.sh
#
#  Everything else (models, temperatures, number of questions, etc.) lives
#  in the profile YAML:
#        config/config.ollama.yaml     (when profile = ollama)
#        config/config.kubeflow.yaml   (when profile = kubeflow)
#        config/config.vllm.yaml       (when profile = vllm)
# =============================================================================


# -----------------------------------------------------------------------------
# [1] PROFILE   —   CHANGE ME
# -----------------------------------------------------------------------------
#  Pick ONE of:
#     ollama    → Ollama already running on this machine      (simplest)
#     kubeflow  → One container that runs Ollama inside it    (for Kubeflow)
#     vllm      → Two separate vLLM GPU containers            (advanced)
#
QAGREDO_PROFILE=@QAGREDO_PROFILE@


# -----------------------------------------------------------------------------
# [2] WHERE ARE YOUR INPUT FILES?   —   CHANGE ME
# -----------------------------------------------------------------------------
#  Uncomment exactly ONE scenario below.
#
#  --- Scenario A: Kubeflow / jovyan (files at /home/jovyan/datasets) ---
# QAGREDO_OFFLINE_HOST=
# QAGREDO_OFFLINE_INPUT=
# QAGREDO_DATA_DIR=/home/jovyan/datasets
#
#  --- Scenario B: Shared drive with txt/ and json/ subfolders ---
QAGREDO_OFFLINE_HOST=data
QAGREDO_OFFLINE_INPUT=txt            # or "json" for .json / .jsonl
#
#  --- Scenario C: Files inside this bundle's data/ folder ---
# QAGREDO_OFFLINE_HOST=repo
# QAGREDO_OFFLINE_INPUT=txt
#
#  --- Scenario D: Custom absolute path ---
# QAGREDO_OFFLINE_HOST=
# QAGREDO_OFFLINE_INPUT=
# QAGREDO_DATA_DIR=/absolute/path/to/your/folder


# -----------------------------------------------------------------------------
# [3] ROOT FOLDERS USED BY THE PRESETS   —   CHANGE ME IF YOU PICKED B or C
# -----------------------------------------------------------------------------
# Offline server default:
#   /data/local/tyewhong/Data/txt
#   /data/local/tyewhong/Data/json
QAGREDO_SHARED_DATA_ROOT=/data/local/tyewhong/Data
# QAGREDO_REPO_DATA_ROOT=@QAGREDO_HOST_DIR@/data
# QAGREDO_WINDOWS_DOWNLOADS_ROOT=/mnt/c/Users/me/Downloads   # WSL only


# -----------------------------------------------------------------------------
# [4] MODELS FOLDER   —   CHANGE ME IF profile=kubeflow OR profile=vllm
# -----------------------------------------------------------------------------
#
#  (a) Ollama store for profile=kubeflow:
#      An Ollama GGUF store (folder with blobs/ and manifests/).
#      Inside the container it appears at /opt/ollama/models.
#
#        Common values:
#          dev server  :  @QAGREDO_HOST_DIR@/models
#          Kubeflow pod:  /home/jovyan/models
#
QAGREDO_MODELS_DIR=@QAGREDO_HOST_DIR@/models

#
#  (b) HuggingFace model directories for profile=vllm:
#      Parent folder containing one HuggingFace dir per model
#      (e.g. Meta-Llama-3.1-8B-Instruct/, Qwen3-8B/).
#      Mounted as /models inside the vLLM containers.
#
QAGREDO_MODELS_LLM_HOST=@QAGREDO_MODELS_LLM_HOST@

# Large .tar / .tar.gz build artifacts (setup_offline.sh searches here first)
QAGREDO_ARCHIVE_DIR=/data/tyewhong/qagredo


# -----------------------------------------------------------------------------
# [5] FILE OWNERSHIP   —   LEAVE ALONE unless you know why
# -----------------------------------------------------------------------------
#  Offline siteserver default: HOST_UID=1013  HOST_GID=1015
#  (setup_offline.sh fills @HOST_UID@ / @HOST_GID@ from id -u / id -g)
HOST_UID=@HOST_UID@
HOST_GID=@HOST_GID@


# =============================================================================
#  Everything below is OPTIONAL and applies only to profile=vllm.
#  Ignored for ollama/kubeflow (those use Ollama tags from config.*.yaml).
# =============================================================================

# ---- vLLM container image (Qwen3.5 needs qwen35 build, not v0.5.3.post1) ----
# Build: bash scripts/docker_build_vllm_qwen35_compat.sh
VLLM_IMAGE=qagredo-vllm:qwen35-localcuda

# ---- Generator (vLLM) — Qwen3.5 on GPU 0, port 7100 ----
VLLM_MODEL=/models/Qwen3.5-9B
VLLM_SERVED_MODEL_NAME=Qwen/Qwen3.5-9B
VLLM_TP_SIZE=1
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_UTIL=0.90
VLLM_API_KEY=llama-local

# ---- Judge (vLLM) — Llama 3.1 on GPU 1, port 7101 ----
VLLM_JUDGE_MODEL=/models/Meta-Llama-3.1-8B-Instruct
VLLM_JUDGE_SERVED_NAME=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_JUDGE_TP_SIZE=1
VLLM_JUDGE_MAX_MODEL_LEN=8192
VLLM_JUDGE_GPU_UTIL=0.90
VLLM_JUDGE_API_KEY=qwen-local

# ---- Ports published on the host (change only if 7100/7101 already taken) ----
VLLM_HOST_PORT=7100
VLLM_JUDGE_HOST_PORT=7101
VLLM_PORT=7100
VLLM_JUDGE_PORT=7101
