# =============================================================================
#  QAG — redserver .env (copy to qag_host/.env)
# =============================================================================
#
#  One-file preset for redserver: orchestrator only, vLLM on gpuserver.
#  Apply on site:
#    cd /home/tyewhong/qag/qag_host
#    bash scripts/offline/apply_redserver_env.sh
#
#  Or manual:
#    cp scripts/offline/dotenv.redserver.template .env
#    # edit HOST_UID / HOST_GID from: id -u / id -g
#
#  See docs/REDSERVER_FILE_REPLACE.md
# =============================================================================

QAG_PROFILE=vllm
QAG_ARCHIVE_DIR=/home/tyewhong/qag

# Pathfinder input (host path → /workspace/data in qag container)
QAG_OFFLINE_HOST=
QAG_OFFLINE_INPUT=
QAG_DATA_DIR=/home/tyewhong/khangzhie-data/pathfinder/txt

# File ownership — run on redserver: id -u && id -g
HOST_UID=@HOST_UID@
HOST_GID=@HOST_GID@
QAG_HOST_DIR=/home/tyewhong/qag

# External vLLM on gpuserver (health checks + pipeline YAML)
QAG_VLLM_CONFIG_FILE=config/config.vllm.redserver.yaml
VLLM_BASE_URL=http://gpuserver:52328/v1
VLLM_JUDGE_BASE_URL=http://gpuserver:53366/v1
QAG_VLLM_COMPOSE_EXTRA=docker-compose.vllm-redserver.yml
# GPUSERVER_IP=<ip>   # if gpuserver hostname fails inside qag container

# Ignored on redserver (no local vLLM containers) — safe defaults.
# Pipeline model names come from config/config.vllm.redserver.yaml instead;
# these local served-name values do not describe gpuserver.
QAG_MODELS_LLM_HOST=/data/models
VLLM_IMAGE=qag-vllm:qwen35-localcuda
VLLM_MODEL=/models/Qwen3.5-9B
VLLM_SERVED_MODEL_NAME=Qwen/Qwen3.5-9B
VLLM_JUDGE_MODEL=/models/Meta-Llama-3.1-8B-Instruct
VLLM_JUDGE_SERVED_NAME=meta-llama/Meta-Llama-3.1-8B-Instruct
VLLM_TP_SIZE=1
VLLM_JUDGE_TP_SIZE=1
VLLM_HOST_PORT=7200
VLLM_JUDGE_HOST_PORT=7201
VLLM_PORT=7100
VLLM_JUDGE_PORT=7101

# -----------------------------------------------------------------------------
# LoRA finetuning (optional) — host-side on redserver; gpuserver vLLM unchanged
# -----------------------------------------------------------------------------
# Generator HF weights for training (NOT for gpuserver inference):
#   tar xzf models_vllm_Qwen3_5-9B.tar.gz -C /data/models
# QAG_LORA_BASE_MODEL=/data/models/Qwen3.5-9B
# QAG_LORA_OUTPUT_DIR=/data/models/Qwen3.5-9B-qag-lora
# QAG_LORA_GPUS=0,1
# QAG_LORA_QUANTIZATION_BIT=0   # fp16; use 4 if OOM
# QAG_LORA_VENV=/home/tyewhong/qag/qag_host/.venv-lora
# SFT: bash run.sh --finetune-lora [RUN_DIR]
# DPO: bash run.sh --finetune-dpo [RUN_DIR]
# See docs/REDSERVER_ONSITE_SETUP.md §8.5
