digraph QAGRedoSequenceFinal {
  graph [
    rankdir=LR,
    splines=polyline,
    bgcolor="#ffffff",
    pad="0.35",
    nodesep="0.45",
    ranksep="0.55",
    dpi=96,
    fontname="Arial",
    fontsize=11,
    labelloc=b,
    labeljust=c,
    label="Step color key — Blue (1,6): Runner ↔ Workflow Engine  ·  Green (2,3): main vLLM  ·  Orange (4,5): vLLM-Judge  ·  Purple (7): Artifacts"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=11,
    margin="0.14,0.10"
  ];

  edge [
    fontname="Arial",
    fontsize=10,
    penwidth=1.4,
    arrowsize=0.75
  ];

  title [shape=plaintext, label="QAGRedo — document processing sequence", fontcolor="#1e3a8a", fontsize=14, fontname="Arial"];

  subgraph cluster_cpu {
    label="";
    style=rounded;
    color="#bae6fd";
    fillcolor="#f0f9ff";
    penwidth=1.2;
    runner;
    engine;
  }

  runner [
    label="Runner\nRuns the pipeline and writes artifacts",
    fillcolor="#dbeafe",
    color="#1d4ed8",
    fontcolor="#0f172a"
  ];
  engine [
    label="Workflow Engine\nOrchestrates pipeline, retries,\ncalling models and quality & confidence checks",
    fillcolor="#cffafe",
    color="#0891b2",
    fontcolor="#0f172a"
  ];
  vllm [
    label="vLLM (Q/A generation)\nGPU 0 | :7100\nProduces questions and answers",
    fillcolor="#dcfce7",
    color="#16a34a",
    fontcolor="#0f172a"
  ];
  judge [
    label="vLLM-Judge\nGPU 1 | :7101\nIndependent grounding verification",
    fillcolor="#fef3c7",
    color="#d97706",
    fontcolor="#0f172a"
  ];
  artifacts [
    label="Artifacts\nOutput files",
    fillcolor="#ede9fe",
    color="#7c3aed",
    fontcolor="#0f172a"
  ];

  cpu [shape=plaintext, label="CPU / internal orchestration (Runner + Workflow Engine)", fontcolor="#0369a1", fontsize=10, fontname="Arial"];

  title -> cpu [style=invis];
  cpu -> runner [style=invis];

  /* Sequence flow */
  runner -> engine [label="1) Start processing one document", color="#2563eb", fontcolor="#1e40af"];
  engine -> vllm [label="2) Ask main model to generate Q&A draft", color="#16a34a", fontcolor="#14532d"];
  vllm -> engine [label="3) Main model returns generated result", color="#16a34a", fontcolor="#14532d"];
  engine -> judge [label="4) If confidence is low: request second opinion", color="#d97706", fontcolor="#92400e"];
  judge -> engine [label="5) Judge returns confidence decision", color="#d97706", fontcolor="#92400e"];
  engine -> runner [label="6) Final choice: keep, simplify, or abstain", color="#2563eb", fontcolor="#1e40af"];
  runner -> artifacts [label="7) Save verified output and run summary", color="#7c3aed", fontcolor="#5b21b6"];

}
